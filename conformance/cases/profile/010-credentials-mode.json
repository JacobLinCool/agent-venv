{
  "case_id": "010-credentials-mode",
  "doc": "Credentials placed via spec.credentials default to mode 0600 on Unix.",
  "request": {
    "op": "ephemeral_lifecycle",
    "spec": {
      "adapter_id": "claude-code",
      "env_overrides": {"CLAUDE_CONFIG_DIR": "$EPHEMERAL_HOME"},
      "credentials": {".credentials.json": "{\"oauth\":\"fake\"}"}
    }
  },
  "expect": {
    "ok": true,
    "inspection_files_present": [".credentials.json"],
    "credentials_mode_unix": 384,
    "events_contain": ["credentials.copied"]
  }
}
